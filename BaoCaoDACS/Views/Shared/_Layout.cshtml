
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <title>@ViewData["Title"] - BaoCaoDACS</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BaoCaoDACS.styles.css" asp-append-version="true" />
    <link href="~/css/layout.css" rel="stylesheet" />
    <script>
        window.appBase = '@Url.Content("~/")';
    </script>
</head>
<body>
    <header class="header">
        <div class="container header-container d-flex align-items-center justify-content-between" style="max-width: 1200px;">
            <div class="logo d-flex align-items-center">
                <img src="~/img/Vctlogo.jpg"
                     alt="Logo" class="rounded-circle me-2" width="40" height="40">
                <span class="fs-5 fw-bold">VCT Score</span>
            </div>
            <nav class="navbar navbar-expand-lg navbar-dark">
                <div class="container-fluid">

                    <a class="navbar-brand text-white fw-normal" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                    <button class="navbar-toggler text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMenu"
                            aria-controls="navbarMenu" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarMenu">
                        <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link text-white fw-normal hover-bold" href="#GiaDau">Giải đấu</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white fw-normal hover-bold" asp-area="" asp-controller="Home" asp-action="LichThidau">Lịch Thi Đấu</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white fw-normal hover-bold" href="#Ketquamoinhat">Kết quả</a>
                            </li>
                            @{
                                var isAdmin = User.IsInRole("Admin") || User.IsInRole("TrongTai");
                            }
                            @if (User?.Identity?.IsAuthenticated ?? false)
                            {
                                @if (isAdmin)
                                {
                                    <li class="nav-item" id="chamDiemNavItem">
                                        <button class="nav-link text-white fw-normal hover-bold" id="chamDiemBtn" onclick="hienThiDanhSachGiaiDau()">Chấm điểm</button>
                                    </li>
                                }
                            }
                            else
                            {
                                <li class="nav-item" id="chamDiemNavItem">
                                    <a asp-area="Identity" asp-page="/Account/Login" class="nav-link text-white fw-normal hover-bold" title="Vui lòng đăng nhập để chấm điểm">Chấm điểm</a>
                                </li>
                            }

                            <li class="nav-item">
                                <a class="nav-link text-white fw-normal hover-bold" href="#">Tin tức</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
            <partial name="_LoginPartial" />
            <div id="real-time-clock" class="ms-2" style="color: white; font-size: 0.8rem; font-weight: bold;"></div>
        </div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer>
        <div class="container">
            <div class="footer-content">
                <div class="footer-section">
                    <h3>Giới thiệu</h3>
                    <p>Hệ thống chấm điểm Võ Cổ Truyền chuyên nghiệp, hiện đại nhất hiện nay.</p>
                    <div class="social-icons">
                        <a href="#" class="social-icon">f</a>
                        <a href="#" class="social-icon">in</a>
                        <a href="#" class="social-icon">yt</a>
                    </div>
                </div>

                <div class="footer-section">
                    <h3>Liên kết</h3>
                    <ul>
                        <li><a href="#">Trang chủ</a></li>
                        <li><a href="#">Giải đấu</a></li>
                        <li><a href="#">Lịch thi đấu</a></li>
                        <li><a href="#">Kết quả</a></li>
                        <li><a href="#">Thống kê</a></li>
                    </ul>
                </div>

                <div class="footer-section">
                    <h3>Hỗ trợ</h3>
                    <ul>
                        <li><a href="#">Hướng dẫn sử dụng</h</li>
                        <li><a href="#">Câu hỏi thường gặp</a></li>
                        <li><a href="#">Liên hệ</a></li>
                        <li><a href="#">Báo lỗi</a></li>
                    </ul>
                </div>

                <div class="footer-section">
                    <h3>Liên hệ</h3>
                    <p>Email: info@vctscore.vn</p>
                    <p>Điện thoại: (84) 91 220 9095</p>
                    <p>Địa chỉ: 123 Nguyễn Văn Linh, TP HCM</p>
                </div>
            </div>

            <div class="copyright">
                &copy; 2025 Hệ thống Chấm điểm Võ Cổ Truyền. Đã đăng ký bản quyền.
            </div>


            <div id="tournamentModal" class="modal-overlay">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5>Chọn trận đấu</h5>

                    </div>
                    <div class="modal-body">
                        <select class="form-select">
                            <option value="">Đang tải dữ liệu...</option>
                        </select>
                        <div class="loading-spinner"></div>
                        <div class="button-group mt-3">
                            <button class="btn btn-confirm">Xác nhận</button>
                            <button class="btn btn-cancel">Hủy bỏ</button>
                        </div>
                    </div>
                </div>
            </div>

            
    </footer>
    <script>
        window.isAuthenticated = @((User?.Identity?.IsAuthenticated ?? false).ToString().ToLower());
        window.appBase = '@Url.Content("~/")';
    </script>﻿
    <script src="https://cdn.botpress.cloud/webchat/v3.5/inject.js" defer></script>
    <script src="https://files.bpcontent.cloud/2025/12/18/15/20251218151104-BHJHKMCP.js" defer></script>
    <!-- jQuery first, then Bootstrap Bundle with Popper -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Custom JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/layout.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://www.gstatic.com/dialogflow-console/fast/messenger/bootstrap.js?v=1"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>


<script>
    const appBase = window.appBase || '@Url.Content("~/")';
    window.appBase = appBase;

    function formatDate(dateString) {
        const date = new Date(dateString);
        return date.toLocaleString('vi-VN', {
            hour: '2-digit',
            minute: '2-digit',
            day: '2-digit',
            month: '2-digit',
            year: 'numeric'
        });
    }
    async function hienThiDanhSachGiaiDau() {
        const modal = document.getElementById('tournamentModal');
        const select = modal.querySelector('select');

        try {
            // Reset trạng thái
            select.innerHTML = '<option value="">Đang tải danh sách...</option>';
            modal.style.display = 'flex';
            modal.querySelector('.loading-spinner').style.display = 'block';

            // Giả sử dữ liệu đã được truyền trực tiếp
            const response = await fetch(`${appBase}Home/GetMatches`, {
                method: 'GET',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                }
            });

            // Kiểm tra phản hồi từ server
            if (!response.ok) {
                throw new Error(`Lỗi kết nối: ${response.status}`);
            }

            // Parse dữ liệu JSON
            const data = await response.json();
            console.log(data);

            // Kiểm tra dữ liệu
            if (!data || data.length === 0) {
                throw new Error('Không có trận đấu nào được tìm thấy');
            }

            // Render options với đầy đủ dataset
            select.innerHTML = data.map(match => `
                    <option value="${match.matchId}"
                        data-date="${match.date || ''}"
                        data-referee="${match.trongtai || 'BTC'}"
                        data-round="${match.vongdau || 'Khởi động'}">
                        ${match.vongdau} - ${match.sanDau} (${(match.date)}) - ${(match.loaiHinhThiDau)}
                    </option>
                `).join('');

            // Mở modal
            modal.style.display = 'flex';
            modal.style.opacity = '1';
            modal.removeAttribute('aria-hidden');

        } catch (error) {
            select.innerHTML = `<option value="">${error.message}</option>`;
            Swal.fire('LỖI TẢI DỮ LIỆU', error.message, 'error');
        } finally {
            modal.querySelector('.loading-spinner').style.display = 'none';
        }
    }

    // Điều chỉnh hàm xuLyChonGiaiDau
    async function xuLyChonGiaiDau(matchId) {
        try {
            if (!matchId || matchId === 'undefined') {
                Swal.fire('Cảnh báo', 'Vui lòng chọn trận đấu hợp lệ', 'warning');
                return;
            }
              // Kiểm tra trạng thái trận đấu trước khi chuyển
        const response = await fetch(`${appBase}ChamDiem/GetMatchParticipants?matchId=${matchId}`, {
            method: 'GET',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            }
        });

        if (!response.ok) {
            throw new Error(`Lỗi kiểm tra trạng thái: ${response.status}`);
        }

        const matchStatus = await response.json();

        // Nếu trạng thái là 1 (đã chấm điểm)
        if (matchStatus.vanDongVien1.trangthai == 1) {
            const { isConfirmed } = await Swal.fire({
                title: 'CẢNH BÁO',
                html: `
                    <div class="text-center">
                        <p>Trận đấu này đã được chấm điểm.</p>
                        <p>Bạn có muốn xem lại kết quả không?</p>
                    </div>
                `,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Xem Kết Quả',
                cancelButtonText: 'Đóng'
            });

            if (isConfirmed) {
                // Chuyển đến trang xem chi tiết kết quả
                window.location.href = `${appBase}Home/index`;
            }
            return;
        }

            // Lấy thông tin từ dataset
            const selectedOption = document.querySelector(`option[value="${matchId}"]`);
                console.log(selectedOption); // In ra toàn bộ phần tử option
            console.log(selectedOption.textContent); // In ra nội dung text trong option
            console.log(selectedOption.value);
                if (!selectedOption) throw new Error('Thông tin trận đấu không hợp lệ');

            // Xác nhận với người dùng
            const { isConfirmed } = await Swal.fire({
                title: 'XÁC NHẬN CHẤM ĐIỂM',
                html: `<div class="text-start">
                             <p>Vòng đấu: <b>${selectedOption.textContent.split(' - ')[0]}</b></p>
                             <p>Địa điểm: ${selectedOption.textContent.split(' - ')[1]})</p>
                            <p>Địa điểm: ${selectedOption.textContent.split(' - ')[2]})</p>
                           </div>`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Đồng Ý',
                cancelButtonText: 'Hủy Bỏ'
            });

            if (isConfirmed) {
                dongModal();

                // Tạo URL params
                const searchParams = new URLSearchParams({
                    matchId: encodeURIComponent(matchId)
                });

                Swal.close();
                setTimeout(() => {
                    window.location.href = `${appBase}ChamDiem/Index?${searchParams.toString()}`;
                }, 200);


                console.log('searchParams:', {
                    matchId: matchId
                });
            }

        } catch (error) {
            Swal.fire('LỖI HỆ THỐNG', error.message, 'error');
            console.error('Chi tiết lỗi:', error);
            dongModal();
        }
    }

    // Thêm sự kiện khi trang tải
    document.addEventListener('DOMContentLoaded', () => {
        // Thêm sự kiện cho nút chấm điểm
        const chamDiemBtn = document.getElementById('chamDiemBtn');
        if (chamDiemBtn) {
            chamDiemBtn.addEventListener('click', hienThiDanhSachGiaiDau);
        }

        // Sự kiện cho select
        const select = document.querySelector('#tournamentModal select');
        if (select) {
            select.addEventListener('change', function (e) {
                xuLyChonGiaiDau(e.target.value);
            });
        }

        // Sự kiện cho nút xác nhận
        const confirmBtn = document.querySelector('.btn-confirm');
        if (confirmBtn) {
            confirmBtn.addEventListener('click', async () => {
                const select = document.querySelector('#tournamentModal select');
                if (select.value) {
                    await xuLyChonGiaiDau(select.value);
                } else {
                    Swal.fire('Lỗi', 'Vui lòng chọn trận đấu trước', 'error');
                }
            });
        }

        // Sự kiện cho nút hủy
        const cancelBtn = document.querySelector('.btn-cancel');
        if (cancelBtn) {
            cancelBtn.addEventListener('click', dongModal);
        }
    });


    function dongModal() {
        const modal = document.getElementById('tournamentModal');

        // Thêm transition
        modal.style.opacity = '0';
        setTimeout(() => {
            modal.style.display = 'none';
            modal.style.opacity = '1';

            // Reset focus an toàn
            document.activeElement.blur();
        }, 300);

        modal.querySelector('select').selectedIndex = 0;

        // Thêm aria-hidden khi đóng
        modal.setAttribute('aria-hidden', 'true');
    }

</script>