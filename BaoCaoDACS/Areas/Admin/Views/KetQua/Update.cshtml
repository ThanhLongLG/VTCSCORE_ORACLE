@model BaoCaoDACS.Models.Socre

@{
    ViewData["Title"] = "Cập nhật Kết Quả";
    Layout = "~/Views/Shared/Admin_layout.cshtml";
}
<head>

    <link href="~/css/site.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
</head>
<div class="container-fluid py-4">
    <nav class="mt-2 mb-4" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a class="text-white text-decoration-none" asp-controller="TrangQL" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item active text-white">Danh sách Kết Quả</li>
        </ol>
    </nav>

    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Cập nhật kết quả</h5>
        </div>
        <div class="card-body">
            <form asp-action="Update" method="post" class="needs-validation" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <input type="hidden" asp-for="ScoreId" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="form-group">
                            <label asp-for="ParticipantId" class="form-label">Vận Động Viên</label>
                            <select asp-for="ParticipantId"
                                    class="form-select"
                                    asp-items="ViewBag.Participants"
                                    required>
                                <option value="">-- Chọn Vận Động Viên --</option>
                            </select>
                            <div class="invalid-feedback">Vui lòng chọn vận động viên.</div>
                            <span asp-validation-for="ParticipantId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="form-group">
                            <label asp-for="MatchId" class="form-label">Trận Đấu</label>
                            <select asp-for="MatchId"
                                    class="form-select"
                                    asp-items="ViewBag.Matches"
                                    required>
                                <option value="">-- Chọn Trận Đấu --</option>
                            </select>
                            <div class="invalid-feedback">Vui lòng chọn trận đấu.</div>
                            <span asp-validation-for="MatchId" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="form-group">
                            <label asp-for="Diem" class="form-label">Điểm Số</label>
                            <input asp-for="Diem"
                                   class="form-control"
                                   type="number"
                                   step="0.01"
                                    />
                            <div class="invalid-feedback">Vui lòng nhập điểm số.</div>
                            <span asp-validation-for="Diem" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="KietQua">Kết quả</label>
                        <input asp-for="KietQua" class="form-control" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Kq">Kết quả bằng số với 1 là thắng 0 là thua</label>
                        <input asp-for="Kq" class="form-control" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12 mb-3">
                        <div class="form-group">
                            <label asp-for="Danhgia" class="form-label">Ghi Chú</label>
                            <textarea asp-for="Danhgia"
                                      class="form-control"
                                      rows="3"></textarea>
                            <span asp-validation-for="Danhgia" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-start gap-3 mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-2"></i> Lưu thay đổi
                    </button>
                    <a class="btn btn-secondary" asp-action="Index">
                        <i class="fas fa-arrow-left me-2"></i> Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>

        // Bootstrap 5 validation
        (() => {
            'use strict'
            const forms = document.querySelectorAll('.needs-validation')
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault()
                        event.stopPropagation()
                    }
                    form.classList.add('was-validated')
                }, false)
            })
        })()
    </script>
}
