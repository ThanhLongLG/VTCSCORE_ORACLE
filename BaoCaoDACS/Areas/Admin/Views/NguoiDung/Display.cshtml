@model BaoCaoDACS.Models.Participant
@{
    ViewData["Title"] = "Chi tiết người tham gia";
    Layout = "~/Views/Shared/Admin_layout.cshtml";
}
<head>

    <link href="~/css/site.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
</head>
@if (Model == null)
{
    <div class="alert alert-danger" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>
        Lỗi: Không tìm thấy thông tin người tham gia!
    </div>
}
else
{
    <div class="container-fluid py-4">
        <nav class="mt-2 mb-4" aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a class="text-white text-decoration-none" asp-controller="TrangQL" asp-action="Index">Trang chủ</a></li>
                <li class="breadcrumb-item active text-white">Danh sách Người Dùng</li>
            </ol>
        </nav>

        <div class="row">
            <div class="col-12">
                <div class="card mb-4">
                    <div class="px-4 py-3 bg-primary text-white rounded-top">
                        <div class="d-flex align-items-center justify-content-between">
                            <h6 class="mb-0 fw-semibold">
                                Chi tiết người tham gia
                            </h6>

                            <a class="btn btn-light btn-sm d-inline-flex align-items-center"
                               asp-action="Index">
                                <i class="fas fa-arrow-left me-2"></i>
                                <span>Quay lại</span>
                            </a>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mx-auto">
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover">
                                        <tbody>
                                            <tr>
                                                <th class="text-primary" style="width: 40%;">Mã người tham gia</th>
                                                <td>@Model.ParticipantID</td>
                                            </tr>
                                            <tr>
                                                <th class="text-primary">Họ và tên</th>
                                                <td>@Model.FullName</td>
                                            </tr>
                                            <tr>
                                                <th class="text-primary">Câu lạc bộ</th>
                                                <td>@Model.Club</td>
                                            </tr>
                                            
                                            @if (Model.sdt != null)
                                            {
                                                <tr>
                                                    <th class="text-primary">Số điện thoại</th>
                                                    <td>@Model.sdt</td>
                                                </tr>
                                            }
                                            @if (Model.email != null)
                                            {
                                                <tr>
                                                    <th class="text-primary">Email</th>
                                                    <td>@Model.email</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        
                    </div>
                </div>
            </div>
        </div>
    </div>
}