@model BaoCaoDACS.Models.Participant
@{
    ViewData["Title"] = "Xác nhận xóa";
    Layout = "~/Views/Shared/Admin_layout.cshtml";
}

@section Styles {
    <link href="~/css/site.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
}

<div class="container py-4">


    <div class="row">
        <div class="col-md-6 mx-auto">
            <div class="card shadow-lg overflow-hidden">
                <!-- Header: dùng div riêng để tránh .card-header của template đè màu -->
                <div class="px-4 py-3 text-white" style="background:#dc3545 !important;">
                    <h5 class="mb-0 d-flex align-items-center">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        Xác nhận xóa
                    </h5>
                </div>

                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <div class="mb-3">
                            <i class="fas fa-user-circle fa-5x text-secondary"></i>
                        </div>
                        <h4 class="mb-1">@Model.FullName</h4>
                        <p class="text-muted mb-0">ID: @Model.ParticipantID</p>
                    </div>

                    <div class="alert alert-warning">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-exclamation-circle me-2"></i>
                            <div>
                                <strong>Cảnh báo!</strong> Bạn sắp xóa người tham gia này. Hành động này không thể hoàn tác.
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive mb-4">
                        <table class="table table-sm align-middle mb-0">
                            <tbody>
                                <tr>
                                    <th style="width:40%;">Họ và tên:</th>
                                    <td>@Model.FullName</td>
                                </tr>
                                <tr>
                                    <th>Câu lạc bộ:</th>
                                    <td>@Model.Club</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ParticipantID" />

                        <div class="d-flex justify-content-center gap-3">
                            <button type="submit" class="btn btn-danger d-inline-flex align-items-center">
                                <i class="fas fa-trash me-2"></i> Xác nhận xóa
                            </button>
                            <a asp-action="Index" class="btn btn-secondary d-inline-flex align-items-center">
                                <i class="fas fa-times me-2"></i> Hủy bỏ
                            </a>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>
