@model BaoCaoDACS.Models.Tournament
@{
    ViewData["Title"] = "Xóa tournament";
    Layout = "~/Views/Shared/Admin_layout.cshtml";
}

@section Styles {
    <link href="~/css/site.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
}

@if (ViewBag.ErrorMessage != null)
{
    <div class="container mt-3">
        <div class="alert alert-danger mb-0">@ViewBag.ErrorMessage</div>
    </div>
}

<div class="container py-4">
    <!-- Breadcrumb: đừng để text-white vì nền đang sáng -->
    <nav class="mb-4" aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item">
                <a class="text-decoration-none text-primary" asp-controller="TrangQL" asp-action="Index">Trang chủ</a>
            </li>
            <li class="breadcrumb-item active text-secondary">Danh sách giải đấu</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-md-6 mx-auto">
            <div class="card shadow-lg overflow-hidden">

                <!-- Header đỏ (tránh .card-header template đè màu) -->
                <div class="px-4 py-3 text-white" style="background:#dc3545 !important;">
                    <h5 class="mb-0 d-flex align-items-center">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        Xác nhận xóa
                    </h5>
                </div>

                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <div class="mb-3">
                            <i class="fas fa-trophy fa-5x text-secondary"></i>
                        </div>
                        <h4 class="mb-1">@Model.Name</h4>
                        <p class="text-muted mb-0">ID: @Model.TournamentID</p>
                    </div>

                    <div class="alert alert-warning">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-exclamation-circle me-2"></i>
                            <div>
                                <strong>Cảnh báo!</strong> Bạn sắp xóa tournament này. Hành động này không thể hoàn tác.
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive mb-4">
                        <table class="table table-sm align-middle mb-0">
                            <tbody>
                                <tr>
                                    <th style="width:40%;">Tên tournament:</th>
                                    <td>@Model.Name</td>
                                </tr>
                                <tr>
                                    <th>Ngày bắt đầu:</th>
                                    <td>@Model.StartDate.ToString("dd/MM/yyyy")</td>
                                </tr>
                                <tr>
                                    <th>Ngày kết thúc:</th>
                                    <td>@Model.EndDate.ToString("dd/MM/yyyy")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="TournamentID" />

                        <div class="d-flex justify-content-center gap-3">
                            <button type="submit" class="btn btn-danger d-inline-flex align-items-center">
                                <i class="fas fa-trash me-2"></i> Xác nhận xóa
                            </button>
                            <a asp-action="Index" class="btn btn-secondary d-inline-flex align-items-center">
                                <i class="fas fa-times me-2"></i> Hủy bỏ
                            </a>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>
