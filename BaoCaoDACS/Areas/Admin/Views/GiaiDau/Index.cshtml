@model IEnumerable<BaoCaoDACS.Models.V_Tournament_All>
@{
    ViewData["Title"] = "Quản lý giải đấu";
    Layout = "~/Views/Shared/Admin_layout.cshtml";
}

<head>
    <link href="~/css/site.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
</head>

<nav class="mt-2 mb-4" aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a class="text-white text-decoration-none" asp-controller="TrangQL" asp-action="Index">Trang chủ</a>
        </li>
        <li class="breadcrumb-item active text-white">Danh sách giải đấu</li>
    </ol>
</nav>

<div class="container-fluid mt-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h4 class="mb-0">Quản lý giải đấu</h4>

            <div class="d-flex gap-2 flex-wrap">
                <form asp-area="Admin"
                      asp-controller="GiaiDau"
                      asp-action="UpdateTournamentStatus"
                      method="post"
                      class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-arrow-repeat me-1"></i> Cập nhật trạng thái
                    </button>
                </form>

                <button type="button"
                        class="btn btn-light"
                        onclick="location.href='@Url.Action("Add", "GiaiDau", new { area = "Admin" })'">
                    <i class="bi bi-plus-circle me-2"></i> Thêm giải đấu mới
                </button>
            </div>
        </div>

        <div class="card-body">
            <div class="row align-items-center mb-3">
                <div class="col-md-5">
                    <form asp-area="Admin" asp-controller="GiaiDau" asp-action="Index" method="get">
                        <div class="input-group">
                            <input name="searchValue"
                                   type="text"
                                   class="form-control"
                                   placeholder="Tìm kiếm theo tên giải đấu..."
                                   value="@ViewBag.searchValue" />
                            <button class="btn btn-primary" type="submit">
                                <i class="bi bi-search me-1"></i> Tìm kiếm
                            </button>
                        </div>
                    </form>
                </div>

                <div class="col-md-7">
                    @if (!string.IsNullOrEmpty(ViewBag.searchValue))
                    {
                        <div class="d-flex align-items-center flex-wrap gap-2">
                            <h6 class="mb-0 text-primary">
                                Kết quả tìm kiếm cho: <strong>"@ViewBag.searchValue"</strong>
                            </h6>
                            <a asp-area="Admin"
                               asp-controller="GiaiDau"
                               asp-action="Index"
                               class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-x-circle me-1"></i> Xóa bộ lọc
                            </a>
                        </div>
                    }
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-hover border">
                    <thead class="table-dark">
                        <tr class="text-center">
                            <th>Tên giải đấu</th>
                            <th>Ngày bắt đầu</th>
                            <th>Ngày kết thúc</th>
                            <th>Trạng thái</th>
                            <th>Số người tham gia</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Name</td>
                                    <td class="text-center">@item.StartDate.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center">@item.EndDate.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center">
                                        @if (item.Status == "Đang diễn ra")
                                        {
                                            <span class="badge bg-success">Đang diễn ra</span>
                                        }
                                        else if (item.Status == "Sắp diễn ra")
                                        {
                                            <span class="badge bg-warning text-dark">Sắp diễn ra</span>
                                        }
                                        else if (item.Status == "Kết thúc")
                                        {
                                            <span class="badge bg-secondary">Kết thúc</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark">@item.Status</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @(ViewBag.ParticipantCounts.ContainsKey(item.TournamentID) ? ViewBag.ParticipantCounts[item.TournamentID] : 0)
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-area="Admin"
                                               asp-controller="GiaiDau"
                                               asp-action="Display"
                                               asp-route-id="@item.TournamentID"
                                               class="btn btn-info btn-sm">
                                                <i class="bi bi-eye me-1"></i> Chi tiết
                                            </a>

                                            <a asp-area="Admin"
                                               asp-controller="GiaiDau"
                                               asp-action="Update"
                                               asp-route-id="@item.TournamentID"
                                               class="btn btn-primary btn-sm">
                                                <i class="bi bi-pencil me-1"></i> Sửa
                                            </a>

                                            <a asp-area="Admin"
                                               asp-controller="GiaiDau"
                                               asp-action="Delete"
                                               asp-route-id="@item.TournamentID"
                                               class="btn btn-danger btn-sm">
                                                <i class="bi bi-trash me-1"></i> Xóa
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center">Không có giải đấu nào</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span>Tổng số: @(Model?.Count() ?? 0) giải đấu</span>
            <a class="btn btn-outline-primary" asp-area="Admin" asp-controller="TrangQL" asp-action="Index">
                <i class="bi bi-arrow-left me-1"></i> Quay lại trang quản trị
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            setTimeout(function () {
                $(".alert").alert('close');
            }, 5000);
        });
    </script>
}