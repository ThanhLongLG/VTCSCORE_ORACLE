@model BaoCaoDACS.Models.Tournament
@{
    ViewData["Title"] = "Chi tiết giải đấu";
    Layout = "~/Views/Shared/Admin_layout.cshtml";
}
<head>

    <link href="~/css/site.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
</head>

@if (Model == null)
{
    <div class="alert alert-danger d-flex align-items-center" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>
        <div>Lỗi: Không tìm thấy thông tin giải đấu!</div>
    </div>
}
else
{
    <div class="container-fluid py-4">
        <nav class="mt-2 mb-4" aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a class="text-white text-decoration-none" asp-controller="TrangQL" asp-action="Index">Trang chủ</a></li>
                <li class="breadcrumb-item active text-white">Danh sách giải đấu</li>
            </ol>
        </nav>

        <div class="row">
            <div class="col-12">
                <div class="card mb-4 shadow">
                    <div class="px-4 py-3 bg-primary text-white rounded-top">
                        <div class="d-flex align-items-center justify-content-between">
                            <h6 class="mb-0 fw-bold">Chi tiết giải đấu</h6>

                            <div class="d-flex align-items-center gap-2">
                                <a class="btn btn-info btn-sm d-inline-flex align-items-center"
                                   asp-action="Edit"
                                   asp-route-id="@Model.TournamentID">
                                    <i class="fas fa-edit me-1"></i>
                                    <span>Sửa</span>
                                </a>

                                <a class="btn btn-light btn-sm d-inline-flex align-items-center"
                                   asp-area="Admin"
                                   asp-controller="GiaiDau"
                                   asp-action="Index">
                                    <i class="fas fa-arrow-left me-1"></i>
                                    <span>Quay lại</span>
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="card-body">
                        <div class="row mb-4">
                            <div class="col-md-8 mx-auto">
                                <div class="table-responsive">
                                    <table class="table table-bordered table-hover">
                                        <tbody>
                                            <tr>
                                                <th class="bg-light text-primary" style="width: 40%;">
                                                    <i class="fas fa-hashtag me-2"></i>Mã giải đấu
                                                </th>
                                                <td>@Model.TournamentID</td>
                                            </tr>
                                            <tr>
                                                <th class="bg-light text-primary">
                                                    <i class="fas fa-trophy me-2"></i>Tên giải đấu
                                                </th>
                                                <td class="fw-bold">@Model.Name</td>
                                            </tr>
                                            <tr>
                                                <th class="bg-light text-primary">
                                                    <i class="fas fa-calendar-alt me-2"></i>Ngày bắt đầu
                                                </th>
                                                <td>@Model.StartDate.ToString("dd/MM/yyyy")</td>
                                            </tr>
                                            <tr>
                                                <th class="bg-light text-primary">
                                                    <i class="fas fa-calendar-check me-2"></i>Ngày kết thúc
                                                </th>
                                                <td>@Model.EndDate.ToString("dd/MM/yyyy")</td>
                                            </tr>
                                            <tr>
                                                <th class="bg-light text-primary">
                                                    <i class="fas fa-map-marker-alt me-2"></i>Địa điểm
                                                </th>
                                                <td>@Model.Location</td>
                                            </tr>
                                            <tr>
                                                <th class="bg-light text-primary">
                                                    <i class="fas fa-running me-2"></i>Hình thức thi đấu
                                                </th>
                                                <td>@Model.HinhThucThiDau</td>
                                            </tr>
                                            <tr>
                                                <th class="bg-light text-primary">
                                                    <i class="fas fa-user-friends me-2"></i>Đối tượng tham gia
                                                </th>
                                                <td>@Model.DoiTuongThamGia</td>
                                            </tr>
                                            <tr>
                                                <th class="bg-light text-primary">
                                                    <i class="fas fa-users-cog me-2"></i>Quy mô tối đa
                                                </th>
                                                <td>@Model.QuyMoiaiDa</td>
                                            </tr>
                                            <tr>
                                                <th class="bg-light text-primary">
                                                    <i class="fas fa-sitemap me-2"></i>Ban tổ chức
                                                </th>
                                                <td>@Model.BanToChuc</td>
                                            </tr>
                                            <tr>
                                                <th class="bg-light text-primary">
                                                    <i class="fas fa-chess me-2"></i>Loại hình thi đấu
                                                </th>
                                                <td>
                                                    @if (Model.LoaiHinhThiDau != null)
                                                    {
                                                        @Model.LoaiHinhThiDau.ToString()
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">Không có thông tin</span>
                                                    }
                                                </td>
                                            </tr>
                                            <tr>
                                                <th class="bg-light text-primary">
                                                    <i class="fas fa-info-circle me-2"></i>Trạng thái
                                                </th>
                                                <td>
                                                    @{
                                                        string badgeClass = "bg-primary";

                                                        switch (Model.Status)
                                                        {
                                                            case "Upcoming":
                                                                badgeClass = "bg-primary";
                                                                break;
                                                            case "Ongoing":
                                                                badgeClass = "bg-success";
                                                                break;
                                                            case "Completed":
                                                                badgeClass = "bg-secondary";
                                                                break;
                                                            case "Cancelled":
                                                                badgeClass = "bg-danger";
                                                                break;
                                                        }

                                                        string statusText = Model.Status switch
                                                        {
                                                            "Upcoming" => "Sắp diễn ra",
                                                            "Ongoing" => "Đang diễn ra",
                                                            "Completed" => "Đã kết thúc",
                                                            "Cancelled" => "Đã hủy",
                                                            _ => Model.Status
                                                        };
                                                    }
                                                    <span class="badge @badgeClass">@statusText</span>
                                                </td>
                                            </tr>
                                            <tr>
                                                <th class="bg-light text-primary">
                                                    <i class="fas fa-image me-2"></i>Hình ảnh
                                                </th>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                                    {
                                                        <img src="@Model.ImageUrl" style="width: 100px; height: 100px; object-fit: cover;" />
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">Không có hình ảnh</span>
                                                    }
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12">
                                <div class="card shadow-sm">
                                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                                        <h6 class="mb-0 text-primary">
                                            <i class="fas fa-users me-2"></i>Danh sách người tham gia
                                            <span class="badge bg-primary ms-2">@(Model.participant?.Count() ?? 0)</span>
                                        </h6>
                                        <a class="btn btn-sm btn-primary"
                                           asp-controller="NguoiDung"
                                           asp-action="Add"
                                           asp-route-tournamentId="@Model.TournamentID">
                                            <i class="fas fa-plus me-1"></i>Thêm người tham gia
                                        </a>
                                    </div>

                                    <div class="card-body p-0">
                                        @if (Model.participant == null || !Model.participant.Any())
                                        {
                                            <div class="text-center py-5">
                                                <i class="fas fa-users text-muted mb-3" style="font-size: 3rem;"></i>
                                                <p class="text-muted">Chưa có người tham gia nào được thêm vào giải đấu này.</p>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="table-responsive">
                                                <table class="table table-hover mb-0 align-middle">
                                                    <thead class="bg-light">
                                                        <tr>
                                                            <th class="text-center" style="width: 5%;">#</th>
                                                            <th style="width: 30%;">Họ và tên</th>
                                                            <th style="width: 20%;">Câu lạc bộ</th>
                                                            <th style="width: 20%;">Liên Hệ</th>
                                                            <th class="text-center" style="width: 15%;">Thao tác</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @{
                                                            int i = 1;
                                                        }
                                                        @foreach (var participant in Model.participant.OrderByDescending(p => p.ParticipantID))
                                                        {
                                                            <tr>
                                                                <td class="text-center">@(i++)</td>
                                                                <td class="fw-bold">@participant.FullName</td>
                                                                <td>@participant.Club</td>
                                                                <td>
                                                                    @if (!string.IsNullOrEmpty(participant.sdt))
                                                                    {
                                                                        <a href="tel:@participant.sdt" class="text-decoration-none me-2" title="Gọi">
                                                                            <i class="fas fa-phone text-primary"></i>
                                                                        </a>
                                                                    }
                                                                    @if (!string.IsNullOrEmpty(participant.email))
                                                                    {
                                                                        <a href="https://mail.google.com/mail/?view=cm&to=@participant.email"
                                                                           class="text-decoration-none"
                                                                           title="Mở Gmail"
                                                                           target="_blank">
                                                                            <i class="fab fa-google text-danger"></i>
                                                                        </a>
                                                                    }
                                                                </td>
                                   
                                                                <td class="text-center">
                                                                    <a class="btn btn-info btn-sm me-1"
                                                                       asp-controller="NguoiDung"
                                                                       asp-action="Display"
                                                                       asp-route-id="@participant.ParticipantID"
                                                                       title="Xem chi tiết">
                                                                        <i class="fas fa-eye"></i>
                                                                    </a>
                                                                    <a class="btn btn-warning btn-sm me-1"
                                                                       asp-controller="NguoiDung"
                                                                       asp-action="Update"
                                                                       asp-route-id="@participant.ParticipantID"
                                                                       title="Chỉnh sửa">
                                                                        <i class="fas fa-edit"></i>
                                                                    </a>
                                                                    <a class="btn btn-danger btn-sm"
                                                                       asp-controller="NguoiDung"
                                                                       asp-action="Delete"
                                                                       asp-route-id="@participant.ParticipantID"
                                                                       onclick="return confirm('Bạn có chắc chắn muốn xóa người tham gia này?');"
                                                                       title="Xóa">
                                                                        <i class="fas fa-trash"></i>
                                                                    </a>
                                                                </td>
                                                            </tr>
                                                         
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}