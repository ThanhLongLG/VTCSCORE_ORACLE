@model IEnumerable<BaoCaoDACS.Models.V_Match_All> 
@{
    Layout = "~/Views/Shared/Admin_layout.cshtml";
}

<head>
    <link href="~/css/site.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    <title>@ViewData["Title"] Admin</title>
    <link href="~/css/admin.css" rel="stylesheet" />
</head>

<div class="container-fluid mt-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Quản lý Trận Đấu</h4>
            <button class="btn btn-light" onclick="location.href='@Url.Action("Add", "TranDau")'">
                <i class="bi bi-plus-circle me-2"></i> Thêm trận đấu
            </button>
        </div>
        <div class="card-body">
            <div class="row align-items-center mb-3">
                <div class="col-md-5">
                    <form asp-controller="TranDau" asp-action="Index" method="get">
                        <div class="input-group">
                            <input name="searchValue" type="text" class="form-control my-input" placeholder="Tìm kiếm Vòng đấu..."
                                   value="@ViewBag.searchValue">
                            <button class="btn btn-primary my-button" type="submit">Tìm kiếm</button>
                        </div>
                    </form>
                </div>
                <div class="col-md-7">
                    @if (!string.IsNullOrEmpty(ViewBag.searchValue))
                    {
                        <div class="d-flex align-items-center">
                            <h6 class="mb-0 text-primary">
                                Kết quả tìm kiếm cho: <strong>"@ViewBag.searchValue"</strong>
                            </h6>
                            <a asp-controller="TranDau" asp-action="Index" class="btn btn-sm btn-outline-secondary ms-3">
                                <i class="bi bi-x-circle me-1"></i> Xóa bộ lọc
                            </a>
                        </div>
                    }
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-hover border">
                    <thead class="table-dark">
                        <tr class="text-white">
                            <th>Vòng đấu</th>
                            <th>Loại hình thi đấu</th>
                            <th>Hạng cân</th>
                            <th>Trọng tài</th>
                            <th>Trạng Thái</th>
                            <th>Ngày thi đấu</th>
                            <th>Giải đấu</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody class="text-light">
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Vongdau</td>
                                
                                <td>@(item.LoaiHinhName ?? "N/A")</td>
                                
                                <td>@item.Hangcan</td>
                                <td>@item.Trongtai</td>
                                
                                @if (item.trangthai == 1)
                                {
                                    <td><span class="badge bg-success">Đã chấm</span></td> }
                                else
                                {
                                    <td><span class="badge bg-warning text-dark">Chưa chấm</span></td>
                                }
                                
                                <td>@item.MatchDate.ToString("dd/MM/yyyy")</td>
                                
                                <td>@(item.TournamentName ?? "Không tham gia giải")</td>
                                
                                <td>
                                    <a asp-action="Display" asp-route-id="@item.MatchId" class="btn btn-info btn-sm">
                                        <i class="bi bi-eye"></i> Chi tiết
                                    </a>
                                    <a asp-action="Update" asp-route-id="@item.MatchId" class="btn btn-primary btn-sm">
                                        <i class="bi bi-pencil"></i> Sửa
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.MatchId" class="btn btn-danger btn-sm">
                                        <i class="bi bi-trash"></i> Xóa
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>