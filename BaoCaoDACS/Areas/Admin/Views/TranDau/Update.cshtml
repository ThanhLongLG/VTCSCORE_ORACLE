@model BaoCaoDACS.Models.Match

@{
    ViewData["Title"] = "Cập nhật Trận Đấu";
    Layout = "~/Views/Shared/Admin_layout.cshtml";
}
<head>

    <link href="~/css/site.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
</head>
<div class="container-fluid py-4">
    <nav class="mt-2 mb-4" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a class="text-white text-decoration-none" asp-controller="TrangQL" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item active text-white">Danh sách Trận Đấu</li>
        </ol>
    </nav>

    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Cập nhật trận đấu</h5>
        </div>
        <div class="card-body">
            <form asp-action="Update" method="post" class="needs-validation" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <input type="hidden" asp-for="MatchId" />

                <div class="row">
                    <div class="form-group col-md-6 mb-3">
                        <label asp-for="Vongdau" class="control-label">Vòng Đấu</label>
                        <select asp-for="Vongdau" class="form-select" required>
                            <option value="">-- Chọn vòng đấu --</option>
                            <option value="Vòng 1">Vòng 1</option>
                            <option value="Vòng 2">Vòng 2</option>
                            <option value="Vòng 3">Vòng 3</option>
                            <option value="Tứ kết">Tứ kết</option>
                            <option value="Bán kết">Bán kết</option>
                            <option value="Chung kết">Chung kết</option>
                        </select>
                        <span asp-validation-for="Vongdau" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="form-group">
                            <label asp-for="SanDau" class="form-label">Sân Đấu</label>
                            <input asp-for="SanDau"
                                   class="form-control"
                                   required
                                   placeholder="Nhập sân đấu" />
                            <div class="invalid-feedback">Vui lòng nhập sân đấu.</div>
                            <span asp-validation-for="SanDau" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="form-group">
                            <label asp-for="Hangcan" class="form-label">Hạng Cân</label>
                            <input asp-for="Hangcan"
                                   class="form-control"
                                   required
                                   placeholder="Nhập hạng cân" />
                            <div class="invalid-feedback">Vui lòng nhập hạng cân.</div>
                            <span asp-validation-for="Hangcan" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="form-group">
                            <label asp-for="Trongtai" class="form-label">Trọng Tài</label>
                            <input asp-for="Trongtai"
                                   class="form-control"
                                   required
                                   placeholder="Nhập tên trọng tài" />
                            <div class="invalid-feedback">Vui lòng nhập tên trọng tài.</div>
                            <span asp-validation-for="Trongtai" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="form-group">
                            <label asp-for="trangthai" class="form-label">Trạng thái (1 or 0 "đã chấm or chưa chấm")</label>
                            <input asp-for="trangthai"
                                   class="form-control"
                                   placeholder="Nhập trạng tháui" />
                            <div class="invalid-feedback">Vui lòng nhập trạng thái.</div>
                            <span asp-validation-for="trangthai" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="form-group">
                            <label asp-for="Date" class="form-label">Ngày Thi Đấu</label>
                            <input asp-for="Date"
                                   class="form-control"
                                   type="datetime-local"
                                   required />
                            <div class="invalid-feedback">Vui lòng chọn ngày thi đấu.</div>
                            <span asp-validation-for="Date" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="form-group">
                            <label asp-for="LoaiHinhThiDauId" class="form-label">Loại Hình Thi Đấu</label>
                            <select asp-for="LoaiHinhThiDauId"
                                    asp-items="ViewBag.LoaiHinhThiDauList"
                                    class="form-control"
                                    required>
                                <option value="">-- Chọn loại hình --</option>
                            </select>
                            <div class="invalid-feedback">Vui lòng chọn loại hình thi đấu.</div>
                            <span asp-validation-for="LoaiHinhThiDauId" class="text-danger"></span>
                        </div>
                    </div>
        
                </div>

                <div class="row">
                    <div class="col-md-12 mb-3">
                        <div class="form-group">
                            <label asp-for="TournamentID" class="form-label">Giải Đấu</label>
                            <select asp-for="TournamentID"
                                    class="form-select"
                                    asp-items="ViewBag.Tournaments">
                                <option value="">-- Chọn Giải Đấu (Không bắt buộc) --</option>
                            </select>
                            <span asp-validation-for="TournamentID" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-start gap-3 mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-2"></i> Lưu thay đổi
                    </button>
                    <a class="btn btn-secondary" asp-action="Index">
                        <i class="fas fa-arrow-left me-2"></i> Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Bootstrap 5 validation
        (() => {
            'use strict'
            const forms = document.querySelectorAll('.needs-validation')
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault()
                        event.stopPropagation()
                    }
                    form.classList.add('was-validated')
                }, false)
            })
        })()
    </script>
}
