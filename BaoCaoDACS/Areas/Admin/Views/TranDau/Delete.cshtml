@model BaoCaoDACS.Models.Match
@{
    ViewData["Title"] = "Xóa Trận Đấu";
    Layout = "~/Views/Shared/Admin_layout.cshtml";
}

@section Styles {
    <link href="~/css/site.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
}

<div class="container py-4">

    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card shadow-lg overflow-hidden">

                <!-- Header đỏ: tránh .card-header template đè màu -->
                <div class="px-4 py-3 text-white" style="background:#dc3545 !important;">
                    <h5 class="mb-0 d-flex align-items-center">
                        <i class="fas fa-trash me-2"></i> Xóa Trận Đấu
                    </h5>
                </div>

                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <div class="mb-3">
                            <i class="fas fa-trophy fa-5x text-secondary"></i>
                        </div>
                        <h4 class="mb-1">Chi Tiết Trận Đấu</h4>
                        <p class="text-muted mb-0">Mã Trận Đấu: @Model.MatchId</p>
                    </div>

                    <div class="alert alert-warning">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-exclamation-circle me-2"></i>
                            <div>
                                <strong>Cảnh báo!</strong> Bạn sắp xóa trận đấu này. Hành động này không thể hoàn tác.
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive mb-4">
                        <table class="table table-bordered align-middle mb-0">
                            <tbody>
                                <tr>
                                    <th class="bg-light" style="width:40%;">Mã Trận Đấu:</th>
                                    <td>@Model.MatchId</td>
                                </tr>
                                <tr>
                                    <th class="bg-light">Vòng Đấu:</th>
                                    <td>@Model.Vongdau</td>
                                </tr>
                                <tr>
                                    <th class="bg-light">Sân Đấu:</th>
                                    <td>@Model.SanDau</td>
                                </tr>
                                <tr>
                                    <th class="bg-light">Hạng Cân:</th>
                                    <td>@Model.Hangcan</td>
                                </tr>
                                <tr>
                                    <th class="bg-light">Trọng Tài:</th>
                                    <td>@Model.Trongtai</td>
                                </tr>
                                <tr>
                                    <th class="bg-light">Ngày Thi Đấu:</th>
                                    <td>@Model.Date.ToString("dd/MM/yyyy HH:mm")</td>
                                </tr>
                                <tr>
                                    <th class="bg-light">Loại Hình Thi Đấu:</th>
                                    <td>@(Model.LoaiHinhThiDau != null ? Model.LoaiHinhThiDau.Name : "Chưa xác định")</td>
                                </tr>
                                <tr>
                                    <th class="bg-light">Giải Đấu:</th>
                                    <td>@(Model.Tournament != null ? Model.Tournament.Name : "Không thuộc giải đấu")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Nên chỉ rõ Area/Controller + AntiForgery -->
                    <form asp-area="Admin" asp-controller="TranDau" asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="MatchId" />

                        <div class="d-flex justify-content-center gap-3">
                            <button type="submit" class="btn btn-danger d-inline-flex align-items-center">
                                <i class="fas fa-trash me-2"></i> Xác Nhận Xóa
                            </button>

                            <a asp-area="Admin" asp-controller="TranDau" asp-action="Index"
                               class="btn btn-secondary d-inline-flex align-items-center">
                                <i class="fas fa-times me-2"></i> Hủy Bỏ
                            </a>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>
